{
  "name": "Invoice → HubSpot Deal Sync",
  "nodes": [
    {
      "id": "0b6f6c4e-1a01-4c1e-9a10-000000000001",
      "name": "Invoice Sync Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "webhookId": "5f1c2d3e-0000-4000-8000-00000000a001",
      "parameters": {
        "httpMethod": "POST",
        "path": "invoice-sync",
        "options": {}
      }
    },
    {
      "id": "0b6f6c4e-1a01-4c1e-9a10-000000000002",
      "name": "Fetch Invoices",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 300],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueErrorOutput",
      "parameters": {
        "url": "https://billing.example.com/api/v2/invoices",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "since", "value": "={{ $json.body.since }}" },
            { "name": "status", "value": "paid" }
          ]
        },
        "options": {
          "pagination": {
            "pagination": {
              "paginationMode": "updateAParameterInEachRequest",
              "parameters": {
                "parameters": [
                  { "type": "qs", "name": "cursor", "value": "={{ $response.body.next }}" }
                ]
              },
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ !$response.body.next }}"
            }
          }
        }
      }
    },
    {
      "id": "0b6f6c4e-1a01-4c1e-9a10-000000000003",
      "name": "Alert Billing Channel",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [440, 520],
      "parameters": {
        "authentication": "accessToken",
        "select": "channel",
        "channelId": { "__rl": true, "mode": "name", "value": "#billing-alerts" },
        "text": "=Invoice sync failed: {{ $json.error?.message ?? 'unknown error' }}",
        "otherOptions": {}
      }
    },
    {
      "id": "0b6f6c4e-1a01-4c1e-9a10-000000000004",
      "name": "Collect Invoices",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 280],
      "parameters": {
        "jsCode": "// Flatten every page's `data` array into one summary item, so the IF below\n// sees a single count however many pages came back.\nconst invoices = $input.all().flatMap((page) => page.json.data ?? []);\nreturn [{ json: { count: invoices.length, invoices } }];"
      }
    },
    {
      "id": "0b6f6c4e-1a01-4c1e-9a10-000000000005",
      "name": "Any Invoices?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [660, 280],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 },
          "conditions": [
            {
              "id": "c1a1b2c3-0000-4000-8000-0000000000c1",
              "leftValue": "={{ $json.count }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "0b6f6c4e-1a01-4c1e-9a10-000000000006",
      "name": "No Invoices",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [880, 420],
      "parameters": {}
    },
    {
      "id": "0b6f6c4e-1a01-4c1e-9a10-000000000007",
      "name": "Split Invoices",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [880, 200],
      "parameters": {
        "fieldToSplitOut": "invoices",
        "options": {}
      }
    },
    {
      "id": "0b6f6c4e-1a01-4c1e-9a10-000000000008",
      "name": "Filter Eligible",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [1100, 200],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 },
          "conditions": [
            {
              "id": "f1a1b2c3-0000-4000-8000-0000000000f1",
              "leftValue": "={{ $json.region }}",
              "rightValue": "={{ $('Invoice Sync Webhook').first().json.body.region }}",
              "operator": { "type": "string", "operation": "equals" }
            },
            {
              "id": "f1a1b2c3-0000-4000-8000-0000000000f2",
              "leftValue": "={{ $json.currency }}",
              "rightValue": "USD",
              "operator": { "type": "string", "operation": "equals" }
            },
            {
              "id": "f1a1b2c3-0000-4000-8000-0000000000f3",
              "leftValue": "={{ $json.hubspot_deal_id }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "0b6f6c4e-1a01-4c1e-9a10-000000000009",
      "name": "Lookup Company",
      "type": "n8n-nodes-base.hubspot",
      "typeVersion": 2.1,
      "position": [1320, 320],
      "parameters": {
        "authentication": "appToken",
        "resource": "company",
        "operation": "searchByDomain",
        "domain": "={{ $json.customer_domain }}",
        "limit": 1,
        "options": {}
      }
    },
    {
      "id": "0b6f6c4e-1a01-4c1e-9a10-000000000010",
      "name": "Match Company",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [1540, 200],
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByFields",
        "advanced": true,
        "mergeByFields": {
          "values": [{ "field1": "customer_domain", "field2": "properties.domain.value" }]
        },
        "joinMode": "keepMatches",
        "outputDataFrom": "both",
        "options": {}
      }
    },
    {
      "id": "0b6f6c4e-1a01-4c1e-9a10-000000000011",
      "name": "Build Deal Update",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1760, 200],
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "a1000000-0000-4000-8000-000000000001", "name": "invoiceId", "value": "={{ $json.id }}", "type": "string" },
            { "id": "a1000000-0000-4000-8000-000000000002", "name": "dealId", "value": "={{ $json.hubspot_deal_id }}", "type": "string" },
            { "id": "a1000000-0000-4000-8000-000000000003", "name": "amount", "value": "={{ ($json.amount_due / 100).toFixed(2) }}", "type": "string" },
            { "id": "a1000000-0000-4000-8000-000000000004", "name": "companyName", "value": "={{ $json.properties.name.value }}", "type": "string" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "0b6f6c4e-1a01-4c1e-9a10-000000000012",
      "name": "Update Deal",
      "type": "n8n-nodes-base.hubspot",
      "typeVersion": 2.1,
      "position": [1980, 200],
      "parameters": {
        "authentication": "appToken",
        "resource": "deal",
        "operation": "update",
        "dealId": { "__rl": true, "mode": "id", "value": "={{ $json.dealId }}" },
        "updateFields": {
          "amount": "={{ $json.amount }}",
          "stage": "closedwon"
        }
      }
    },
    {
      "id": "0b6f6c4e-1a01-4c1e-9a10-000000000013",
      "name": "Audit Log",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [2200, 200],
      "parameters": {
        "schema": { "__rl": true, "mode": "list", "value": "public" },
        "table": { "__rl": true, "mode": "name", "value": "invoice_sync_audit" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "invoice_id": "={{ $('Build Deal Update').item.json.invoiceId }}",
            "deal_id": "={{ $('Build Deal Update').item.json.dealId }}",
            "amount": "={{ $('Build Deal Update').item.json.amount }}",
            "synced_at": "={{ $now.toISO() }}"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      }
    }
  ],
  "connections": {
    "Invoice Sync Webhook": {
      "main": [[{ "node": "Fetch Invoices", "type": "main", "index": 0 }]]
    },
    "Fetch Invoices": {
      "main": [
        [{ "node": "Collect Invoices", "type": "main", "index": 0 }],
        [{ "node": "Alert Billing Channel", "type": "main", "index": 0 }]
      ]
    },
    "Collect Invoices": {
      "main": [[{ "node": "Any Invoices?", "type": "main", "index": 0 }]]
    },
    "Any Invoices?": {
      "main": [
        [{ "node": "Split Invoices", "type": "main", "index": 0 }],
        [{ "node": "No Invoices", "type": "main", "index": 0 }]
      ]
    },
    "Split Invoices": {
      "main": [[{ "node": "Filter Eligible", "type": "main", "index": 0 }]]
    },
    "Filter Eligible": {
      "main": [
        [
          { "node": "Match Company", "type": "main", "index": 0 },
          { "node": "Lookup Company", "type": "main", "index": 0 }
        ]
      ]
    },
    "Lookup Company": {
      "main": [[{ "node": "Match Company", "type": "main", "index": 1 }]]
    },
    "Match Company": {
      "main": [[{ "node": "Build Deal Update", "type": "main", "index": 0 }]]
    },
    "Build Deal Update": {
      "main": [[{ "node": "Update Deal", "type": "main", "index": 0 }]]
    },
    "Update Deal": {
      "main": [[{ "node": "Audit Log", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
